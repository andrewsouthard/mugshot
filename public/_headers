# Cloudflare Pages response headers. next.config.ts headers() is ignored by
# a static export, so they live here.

# Always revalidate the service worker so updates roll out promptly.
/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self'

# Generated icons are exported without a file extension.
/icon/*
  Content-Type: image/png

/apple-icon
  Content-Type: image/png
